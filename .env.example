# Kopieer naar .env (of stel in bij je host). Nooit echte waarden committen.
PORT=3000
# Publieke adres zoals spelers het zien (voor QR-code en links), zonder slash aan het eind
PUBLIC_URL=https://bamigo.example.nl
# Wachtwoord om nieuwe avonden/demo's aan te maken (lang en willekeurig)
BAMIGO_ADMIN_PASSWORD=verander-mij-in-iets-lang-en-willekeurigs
# Opslag (zet op een blijvend volume)
BAMIGO_DB=/data/bamigo.db
BAMIGO_MEDIA=/data/media
